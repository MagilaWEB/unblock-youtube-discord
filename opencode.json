{
  "$schema": "https://opencode.ai/config.json",
  // ПРИМЕЧАНИЕ: opencode читает этот файл как JSONC, комментарии допустимы.
  //
  // КАК ВСЁ ПОДНЯТЬ НОВОМУ РАЗРАБОТЧИКУ (или модели, которая его онбордит):
  // 1. Поставь Node.js >= 18 и добавь его в PATH. Если лень — просто запускай
  //    через run_opencode.bat: он сам подхватит %ProgramFiles%\nodejs в PATH.
  // 2. Поставь LLVM (нужен clangd.exe) и добавь его bin/ в PATH — встроенный LSP
  //    opencode поднимает clangd для C/C++ (см. блок lsp ниже).
  // 3. Сконфигурируй сборку, чтобы лежал _build_ai/compile_commands.json:
  //    configure-ninja-ai.bat, затем сборка через build-ai.ps1.
  //    Без compile_commands.json диагностика будет сыпать ложными «file not found».
  // 4. Запускай opencode через run_opencode.bat из корня репо: он чинит PATH.
  // ДИАГНОСТИКА: `run_opencode.bat mcp list` — gh_grep/github должны быть `connected`.
  "formatter": {
    "clang-format": {}
  },
  // Встроенный clangd. Команду задаём явно, чтобы opencode не тянул авто-скачанный
  // clangd, и указываем compile_commands из _build_ai — иначе индекс протухает и на
  // переехавшие заголовки летят ложные ошибки. --pch-storage=disk снижает память.
  "lsp": {
    "clangd": {
      "command": [
        "clangd",
        "--background-index",
        "--compile-commands-dir=_build_ai",
        "--header-insertion=never",
        "--pch-storage=disk"
      ],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".c++", ".h", ".hpp", ".hh", ".hxx", ".h++"]
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "description": "C++ builder for unblock (Ninja+clang, _build_ai)",
      "tools": {
        "gh_grep*": true
      }
    }
  },
  "watcher": {
    "ignore": ["_build_ai/**", "_build/**", "**/_deps/**", "bin/**", ".git/**"]
  },
  "plugin": ["opencode-morph-fast-apply", "opencode-shell-strategy"]
}
