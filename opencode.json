{
  "$schema": "https://opencode.ai/config.json",
  // ПРИМЕЧАНИЕ: opencode читает этот файл как JSONC, комментарии допустимы.
  //
  // КАК ВСЁ ПОДНЯТЬ НОВОМУ РАЗРАБОТЧИКУ (или модели, которая его онбордит):
  // 1. Поставь Node.js >= 18 и добавь его в PATH. Если лень — просто запускай
  //    через run_opencode.bat: он сам подхватит %ProgramFiles%\nodejs в PATH.
  // 2. Сконфигурируй сборку, чтобы лежал _build_ai/compile_commands.json:
  //    configure-ninja-ai.bat, затем сборка через build-ai.ps1.
  // 3. Запускай opencode через run_opencode.bat из корня репо: он чинит PATH.
  // ДИАГНОСТИКА: `run_opencode.bat mcp list` — gh_grep/github должны быть `connected`.
  //
  // ВАЖНО: конфиг в нативном формате opencode2. V2 НЕ поднимает LSP: серверы
  // языка и диагностика недоступны в принципе, поэтому V1-блок `lsp` (clangd) не
  // перенесён и LLVM в онбординге больше не нужен. Источник диагностики C/C++ —
  // сборка (build-ai.ps1) и clang-tidy (tidy-ai.ps1).
  "formatter": {
    "clang-format": {}
  },
  // V2: MCP-серверы живут под mcp.servers.<имя>. Флаг включения инвертирован —
  // в V1 был `enabled: true`, в V2 сервер включён, пока нет `disabled: true`.
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  // V2: `agent` → `agents`. V1-поле `tools` (карта вкл/выкл по имени тула) в V2
  // не поддерживается — доступ к тулам выражается правилами permissions.
  "agents": {
    "build": {
      "description": "C++ builder for unblock (Ninja+clang, _build_ai)",
      "permissions": [
        { "action": "gh_grep*", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "watcher": {
    "ignore": ["_build_ai/**", "_build/**", "**/_deps/**", "bin/**", ".git/**"]
  }
}
