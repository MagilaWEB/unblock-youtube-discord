// Zapret1 (winws.exe): adapted from Flowseal/zapret-discord-youtube preset "general (FAKE TLS AUTO).bat"; filters mapped to unblock sections, fake blobs to binaries/fake/.
[START]
--wf-tcp=80,443,%DiscordPort%,%GamePort%
--wf-udp=443,%DiscordPortUPD%,%GamePort%

--new
--filter-udp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=11
%FAKE_QUIC%

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun
--dpi-desync=fake
%FAKE_DISCORD%
%FAKE_STUN%
--dpi-desync-repeats=6

--new
--filter-tcp=%DiscordPort%
--hostlist-domains=discord.media
--dpi-desync=fake,multidisorder
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=11
--dpi-desync-fooling=badseq
--dpi-desync-fake-tls=0x00000000
--dpi-desync-fake-tls=
!
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com

[instagram]
use_in>>youtube

[youtube]
--new
--filter-tcp=443
%BLOCKLIST%
--ip-id=zero
--dpi-desync=fake,multidisorder
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=11
--dpi-desync-fooling=badseq
--dpi-desync-fake-tls=0x00000000
--dpi-desync-fake-tls=
!
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com

[END]
--new
--filter-tcp=80,443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake,multidisorder
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=11
--dpi-desync-fooling=badseq
--dpi-desync-fake-tls=0x00000000
--dpi-desync-fake-tls=
!
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
%FAKE_HTTP%

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[game_mod]
--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=11
%FAKE_QUIC%

--new
--filter-tcp=80,443,8443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake,multidisorder
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=11
--dpi-desync-fooling=badseq
--dpi-desync-fake-tls=0x00000000
--dpi-desync-fake-tls=
!
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
%FAKE_HTTP%

--new
--filter-tcp=0,%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=fake,multidisorder
--dpi-desync-any-protocol=1
--dpi-desync-cutoff=n4
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=11
--dpi-desync-fooling=badseq
--dpi-desync-fake-tls=0x00000000
--dpi-desync-fake-tls=
!
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
%FAKE_HTTP%
--dpi-desync-fake-unknown=0x00000000
--dpi-desync-fake-unknown="%FAKE%tls_clienthello_max_ru.bin"

--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=10
--dpi-desync-any-protocol=1
%FAKE_UNKNOWN%
--dpi-desync-cutoff=n2
