// Zapret1 (winws.exe): adapted from Flowseal/zapret-discord-youtube preset "general (ALT2).bat"; filters mapped to unblock sections, fake blobs to binaries/fake/.
[START]
--wf-tcp=80,443,%DiscordPort%,%GamePort%
--wf-udp=443,%DiscordPortUPD%,%GamePort%

--new
--filter-udp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=6
%FAKE_QUIC%

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun
--dpi-desync=fake
%FAKE_DISCORD%
%FAKE_STUN%
--dpi-desync-repeats=6

--new
--filter-tcp=%DiscordPort%
--hostlist-domains=discord.media
--dpi-desync=multisplit
--dpi-desync-split-seqovl=652
--dpi-desync-split-pos=2
%SEQOVL_PATTERN%

[instagram]
use_in>>youtube

[youtube]
--new
--filter-tcp=443
%BLOCKLIST%
--ip-id=zero
--dpi-desync=multisplit
--dpi-desync-split-seqovl=652
--dpi-desync-split-pos=2
%SEQOVL_PATTERN%

[END]
--new
--filter-tcp=80,443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=multisplit
--dpi-desync-split-seqovl=652
--dpi-desync-split-pos=2
%SEQOVL_PATTERN%

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[game_mod]
--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=6
%FAKE_QUIC%

--new
--filter-tcp=80,443,8443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=multisplit
--dpi-desync-split-seqovl=652
--dpi-desync-split-pos=2
%SEQOVL_PATTERN%

--new
--filter-tcp=%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=multisplit
--dpi-desync-any-protocol=1
--dpi-desync-cutoff=n3
--dpi-desync-split-seqovl=652
--dpi-desync-split-pos=2
%SEQOVL_PATTERN%

--new
--filter-udp=%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=12
--dpi-desync-any-protocol=1
%FAKE_UNKNOWN%
--dpi-desync-cutoff=n2
