// Zapret1 (winws.exe): adapted from Flowseal/zapret-discord-youtube preset "general (ALT5).bat"; filters mapped to unblock sections, fake blobs to binaries/fake/.
[START]
--wf-tcp=80,443,%DiscordPort%,%GamePort%
--wf-udp=443,%DiscordPortUPD%,%GamePort%

--new
--filter-udp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=6
%FAKE_QUIC%

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun
--dpi-desync=fake
%FAKE_DISCORD%
%FAKE_STUN%
--dpi-desync-repeats=6

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[game_mod]
--new
--filter-tcp=0,%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=syndata,multidisorder
--dpi-desync-any-protocol=1
--dpi-desync-cutoff=n4

--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=6
%FAKE_QUIC%

--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-repeats=14
--dpi-desync-any-protocol=1
%FAKE_UNKNOWN%
--dpi-desync-cutoff=n3
