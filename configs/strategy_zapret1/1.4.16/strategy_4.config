// Zapret1 (winws.exe): restored from tag v1.4.19; applied fixes: desync typo, fake-dir prefix, obsolete port placeholders and section dropped.
[START]
--wf-tcp=80,443,%DiscordPort%,%GamePort%
--wf-udp=443,%DiscordPortUPD%,%GamePort%

--new
--filter-udp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=hostfakesplit
%FAKE_HOST_DOMAIN%
--dpi-desync-hostfakesplit-midhost=host-4
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=6
%FAKE_QUIC%

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun
--dpi-desync=fake
%FAKE_DISCORD%
%FAKE_STUN%
--dpi-desync-repeats=6

--new
--filter-tcp=%DiscordPort%
--hostlist-domains=discord.media
--dpi-desync=hostfakesplit
%FAKE_HOST_DOMAIN%
--dpi-desync-hostfakesplit-midhost=host-4
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1,midsld
%SEQOVL_PATTERN%

[END]
--new
--filter-tcp=80,443
--ip-id=zero
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake,hostfakesplit
%FAKE_HOST_DOMAIN%
--dpi-desync-hostfakesplit-midhost=host-4
--dpi-desync-split-seqovl=726
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=ts,badseq
--dpi-desync-badseq-increment=0
--dpi-desync-repeats=16
%SEQOVL_PATTERN%
--dpi-desync-fake-tls="%FAKE%stun.bin"
%FAKE_HTTP%

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[game_mod]
--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=hostfakesplit
%FAKE_HOST_DOMAIN%
--dpi-desync-hostfakesplit-midhost=host-4
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1,midsld
--dpi-desync-repeats=6
%FAKE_QUIC%

--new
--filter-tcp=80,443,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--ip-id=zero
--dpi-desync=hostfakesplit
%FAKE_HOST_DOMAIN%
--dpi-desync-hostfakesplit-midhost=host-4
--dpi-desync-split-seqovl=726
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=ts,badseq
--dpi-desync-badseq-increment=0
--dpi-desync-repeats=16
%SEQOVL_PATTERN%
--dpi-desync-fake-tls="%FAKE%stun.bin"
%FAKE_HTTP%

--new
--filter-udp=%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--dpi-desync=fake
--dpi-desync-autottl=2
--dpi-desync-repeats=10
--dpi-desync-any-protocol=1
%FAKE_UNKNOWN%
--dpi-desync-cutoff=n2
