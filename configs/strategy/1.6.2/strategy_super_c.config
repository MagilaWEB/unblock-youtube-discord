[START]
--ctrack-disable=0
--ipcache-lifetime=8400
--ipcache-hostname=1
--wf-filter-loopback=0
--wf-tcp-in=80,443,%DiscordPort%
--wf-udp-in=443,10000,%DiscordPortUPD%,%GamePort%
--wf-tcp-out=80,443,%DiscordPort%
--wf-udp-out=443,10000,%DiscordPortUPD%,%GamePort%

%INIT_LUA%
%INIT_BLOB%
--blob=fake_default_udp:0x00000000000000000000000000000000

--template=START_QUIC
--lua-desync=auto_strategy:fails=4
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=16:strategy=1
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:strategy=2
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:badsum:strategy=2
