--new
--template=START_VOICE
--lua-desync=auto_strategy:fails=4:start=1
--lua-desync=fake:payload=all:blob=fake_default_udp:repeats=2:strategy=1
--lua-desync=fake:payload=all:blob=QUIC_GOOGLE:repeats=2:strategy=2
--lua-desync=fake:payload=all:blob=fake_default_quic:repeats=2:strategy=3
--lua-desync=fake:payload=all:blob=fake_default_udp:repeats=2:badsum:strategy=4
--lua-desync=fake:payload=all:blob=QUIC_GOOGLE:repeats=2:badsum:strategy=5
--lua-desync=fake:payload=all:blob=fake_default_udp:repeats=4:strategy=6
--lua-desync=fake:payload=all:blob=QUIC_VK:repeats=2:badsum:strategy=7
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:strategy=8
--lua-desync=drop:strategy=8
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:ipfrag_disorder:strategy=9
--lua-desync=drop:strategy=9
