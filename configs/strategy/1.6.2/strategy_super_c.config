--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:repeats=6:strategy=5
--lua-desync=fake:blob=QUIC_FACEBOOK:repeats=6:badsum:strategy=5
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:repeats=6:strategy=6
--lua-desync=fake:blob=QUIC_SHORT:repeats=6:badsum:strategy=6
--lua-desync=fake:blob=QUIC_SHORT_HEADER:repeats=6:strategy=7
--lua-desync=fake:blob=fake_default_udp:repeats=6:badsum:strategy=7
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ip_ttl=5:strategy=8
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ip_ttl=5:badsum:strategy=8
--lua-desync=fake:blob=QUIC_VK:repeats=6:ip_ttl=5:badsum:strategy=9
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=6:ip_ttl=5:badsum:strategy=9
--lua-desync=fake:ip_id=zero:blob=QUIC_GOOGLE:repeats=6:ip_ttl=5:badsum:strategy=10
--lua-desync=fake:ip_id=zero:blob=QUIC_VK:repeats=6:ip_ttl=5:badsum:strategy=10
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ipfrag:ipfrag_pos_udp=8:badsum:strategy=11
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ipfrag:ipfrag_pos_udp=16:badsum:strategy=11
--lua-desync=fake:ip_id=zero:blob=QUIC_GOOGLE:repeats=16:ipfrag:ipfrag_pos_udp=8:badsum:strategy=12
--lua-desync=fake:blob=fake_default_quic:repeats=6:strategy=13
--lua-desync=fake:blob=fake_default_quic:repeats=6:badsum:strategy=13
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ip_ttl=3:badsum:strategy=14
--lua-desync=fake:blob=fake_default_udp:repeats=6:ip_ttl=3:badsum:strategy=14
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:strategy=15
--lua-desync=drop:strategy=15
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:ipfrag_disorder:strategy=16
--lua-desync=drop:strategy=16
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=4:strategy=17
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:strategy=17
--lua-desync=drop:strategy=17
--lua-desync=udplen:increment=2:strategy=18
--lua-desync=udplen:increment=2:strategy=19
--lua-desync=fake:blob=fake_default_quic:repeats=2:strategy=19
--lua-desync=fake:blob=QUIC_4PDA:repeats=6:strategy=20
--lua-desync=fake:blob=QUIC_4PDA:repeats=6:badsum:strategy=20
--lua-desync=fake:ip_id=zero:blob=QUIC_4PDA:repeats=6:ipfrag:ipfrag_pos_udp=8:badsum:strategy=21
--lua-desync=fake:blob=QUIC_4PDA:repeats=16:ipfrag:ipfrag_pos_udp=8:badsum:strategy=21

--new
--template=START_TLS
--lua-desync=auto_strategy:fails=4:maxseq=32768:reset
--lua-desync=fake:blob=TLS_GOOGLE:repeats=6:tcp_ts=-600000:strategy=1
