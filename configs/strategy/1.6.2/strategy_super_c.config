--lua-desync=fake:payload=all:blob=GAME_ACTIVE:repeats=2:badsum:strategy=14
--lua-desync=drop:strategy=11

--new
--template=START_VOICE_TCP
--lua-desync=auto_strategy:fails=1:maxseq=32768:reset:start=1
--lua-desync=multisplit:pos=host+3:strategy=1
--lua-desync=multisplit:pos=sniext,endhost:strategy=2
--lua-desync=fakedsplit:pos=host+3:seqovl=620:seqovl_pattern=TLS_GOOGLE:repeats=6:tcp_ts=-600000:strategy=3
--lua-desync=fakedsplit:pos=host+3:seqovl=620:seqovl_pattern=TLS_GOOGLE:repeats=6:tcp_ts=-600000:badsum:strategy=3
--lua-desync=hostfakesplit:host=www.google.com:midhost=midsld:repeats=6:tcp_ts=-600000:tcp_md5:badsum:strategy=4
--lua-desync=hostfakesplit:host=www.google.com:midhost=midsld:disorder_after=-1:repeats=6:tcp_md5:badsum:strategy=5
--lua-desync=fakeddisorder:pos=host+3:seqovl=2:repeats=6:tcp_ts=-600000:tcp_md5:strategy=6
--lua-desync=fakeddisorder:pos=host+3:seqovl=2:repeats=6:tcp_ts=-600000:tcp_md5:badsum:strategy=6
--lua-desync=fake:blob=TLS_GOOGLE:repeats=6:tcp_ts=-600000:strategy=7
--lua-desync=fake:blob=TLS_GOOGLE:repeats=6:tcp_ts=-600000:badsum:strategy=7
--lua-desync=multisplit:pos=host+3:seqovl=620:seqovl_pattern=TLS_SOCHI:repeats=6:tcp_ts=-600000:strategy=8
--lua-desync=multisplit:pos=host+3:seqovl=620:seqovl_pattern=TLS_SOCHI:repeats=6:tcp_ts=-600000:badsum:strategy=8

--new
--filter-udp=443
--filter-l7=quic
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=quic_initial
--import=START_QUIC

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun,quic
--payload=all
--import=START_VOICE

--new
--filter-tcp=%DiscordPort%
--filter-l7=tls
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello
--import=START_VOICE_TCP

[END]
--new
--filter-tcp=80,443,%DiscordPort%
--filter-l7=http,tls
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello,http_req
--import=START_TLS

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[game_mod]
--new
--filter-tcp=80,443,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello
--import=START_TLS

--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--out-range=-n8
--payload=all
--import=START_VOICE
