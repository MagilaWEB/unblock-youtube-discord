--new
--filter-udp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--import=START_QUIC

%TEMPLATES_DISCORD_UDP%
--payload=quic_initial,discord_ip_discovery,stun
--import=START_QUIC

%TEMPLATES_END_TCP%
--payload=tls_client_hello,http_req
--import=START_TLS

%TEMPLATES_SERVICE_LISTS%

[game_mod]
--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--import=START_QUIC

%TEMPLATES_GAME_TCP%
--import=START_TLS

--new
--filter-udp=0,%GamePort%
--payload=all
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--lua-desync=auto_strategy:fails=6:time=90:udp_out=8
--lua-desync=fake:blob=fake_default_udp:autottl=2:repeats=12:cutoff=n3
