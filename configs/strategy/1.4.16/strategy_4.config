// Converted from v1.4.19 tag (static --dpi-desync) to --lua-desync=auto_strategy (helper protocol).
// Mapping: END syndata,multidisorder (no params) -> composite strategy=1. No BLOCKLIST / no discord-tcp / no youtube / no game-tcp in source (kept 1:1).
// Dead runtime-bound placeholders dropped: %FAKE_*% (bound to user fake key), %SEQOVL_PATTERN% (bound clienthello -> theme blob),
// %BINARIES%, %MessengersPort*%, %TorrentPort%, altorder, tls-mod, any-protocol. Engine strips unknown %VARS% anyway.
[START]
--wf-filter-loopback=0
--wf-tcp-in=80,443,%DiscordPort%
--wf-udp-in=443,10000,%DiscordPortUPD%,%GamePort%
--wf-tcp-out=80,443,%DiscordPort%
--wf-udp-out=443,10000,%DiscordPortUPD%,%GamePort%

%INIT_LUA%
%INIT_BLOB%
--blob=fake_default_udp:0x00
--blob=fake_default_tcp:0x00

--template=START_QUIC
--lua-desync=auto_strategy:fails=4
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=8:strategy=1
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=8:strategy=2
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER1:repeats=8:strategy=3
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:repeats=8:strategy=4
--lua-desync=fake:blob=QUIC_VK:repeats=8:strategy=5
--lua-desync=fake:blob=QUIC_FACEBOOK:repeats=8:strategy=6
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:repeats=8:strategy=7
--lua-desync=fake:blob=QUIC_SHORT:repeats=8:strategy=8
--lua-desync=fake:blob=QUIC_SHORT_HEADER:repeats=8:strategy=9
--lua-desync=fake:blob=fake_default_udp:repeats=8:strategy=10
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:badsum:strategy=11
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=6:badsum:strategy=12
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER1:repeats=6:badsum:strategy=13
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:repeats=6:badsum:strategy=14
--lua-desync=fake:blob=QUIC_VK:repeats=6:badsum:strategy=15
--lua-desync=fake:blob=QUIC_FACEBOOK:repeats=6:badsum:strategy=16
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:repeats=6:badsum:strategy=17
--lua-desync=fake:blob=QUIC_SHORT:repeats=6:badsum:strategy=18
--lua-desync=fake:blob=QUIC_SHORT_HEADER:repeats=6:badsum:strategy=19
--lua-desync=fake:blob=fake_default_udp:repeats=6:badsum:strategy=20
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:tcp_md5:badsum:strategy=21
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=6:tcp_md5:badsum:strategy=22
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER1:repeats=6:tcp_md5:badsum:strategy=23
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:repeats=6:tcp_md5:badsum:strategy=24
--lua-desync=fake:blob=QUIC_VK:repeats=6:tcp_md5:badsum:strategy=25
--lua-desync=fake:blob=QUIC_FACEBOOK:repeats=6:tcp_md5:badsum:strategy=26
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:repeats=6:tcp_md5:badsum:strategy=27
--lua-desync=fake:blob=QUIC_SHORT:repeats=6:tcp_md5:badsum:strategy=28
--lua-desync=fake:blob=QUIC_SHORT_HEADER:repeats=6:tcp_md5:badsum:strategy=29
--lua-desync=fake:blob=fake_default_udp:repeats=6:tcp_md5:badsum:strategy=30
--new
--template=START_TLS
--lua-desync=auto_strategy:fails=4:maxseq=32768:reset
--lua-desync=syndata:strategy=1
--lua-desync=multidisorder:strategy=1

--new
--filter-udp=443
--filter-l7=quic
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=quic_initial
--import=START_QUIC

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun,quic
--payload=quic_initial,discord_ip_discovery,stun
--import=START_QUIC

[END]
--new
--filter-l3=ipv4
--filter-tcp=80,443,%DiscordPort%
--filter-l7=http,tls
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello,http_req
--import=START_TLS

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[roblox]
use_in>>game_mod

[game_mod]
--new
--filter-udp=443
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--import=START_QUIC

--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=all
--lua-desync=auto_strategy:fails=4
--lua-desync=fake:blob=fake_default_udp:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=1
--lua-desync=fake:blob=QUIC_GOOGLE:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=2
--lua-desync=fake:blob=QUIC_VK:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=3
--lua-desync=fake:blob=QUIC_RUTRACKER:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=4
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER1:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=5
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=6
--lua-desync=fake:blob=QUIC_FACEBOOK:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=7
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=8
--lua-desync=fake:blob=QUIC_SHORT:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=9
--lua-desync=fake:blob=QUIC_SHORT_HEADER:ip_autottl=2:ip6_autottl=2:repeats=14:cutoff=n3:strategy=10
