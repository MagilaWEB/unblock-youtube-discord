[START]
--wf-filter-loopback=0
--wf-tcp-in=80,443,%DiscordPort%
--wf-udp-in=443,10000,%DiscordPortUPD%,%GamePort%
--wf-tcp-out=80,443,%DiscordPort%
--wf-udp-out=443,10000,%DiscordPortUPD%,%GamePort%

%INIT_LUA%
%INIT_BLOB%
--blob=fake_default_udp:0x00000000000000000000000000000000
--blob=fake_default_tcp:0x00

--template=START_QUIC
--lua-desync=auto_strategy:fails=4
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:strategy=1
--lua-desync=fake:blob=QUIC_VK:repeats=6:strategy=2
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=6:strategy=3
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER1:repeats=6:strategy=4
--lua-desync=fake:blob=QUIC_RUTRACKER_KYBER2:repeats=6:strategy=5
--lua-desync=fake:blob=QUIC_FACEBOOK:repeats=6:strategy=6
--lua-desync=fake:blob=QUIC_FACEBOOK_QUICHE:repeats=6:strategy=7
--lua-desync=fake:blob=QUIC_SHORT:repeats=6:strategy=8
--lua-desync=fake:blob=QUIC_SHORT_HEADER:repeats=6:strategy=9
--lua-desync=fake:blob=fake_default_udp:repeats=6:strategy=10

--new
--template=START_TLS
--lua-desync=auto_strategy:fails=4:maxseq=32768:reset
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=336:repeats=6:tcp_ts=-600000:tcp_md5:badsum:nodrop
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=400:repeats=6:tcp_ts=-5000000:tcp_md5:badsum:nodrop
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=500:repeats=8:tcp_seq=1000:tcp_md5:badsum:nodrop
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=336:repeats=6:tcp_ts=-600000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=336:repeats=6:tcp_ts=-5000000:tcp_ts_up:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=336:repeats=6:tcp_ts=99999999:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=400:repeats=6:tcp_ts=-5000000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=500:repeats=8:tcp_seq=1000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=70:repeats=6:tcp_ts=-600000:tcp_md5:badsum:nodrop
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=120:repeats=6:tcp_ts=-600000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=180:repeats=6:tcp_ts=-5000000:tcp_ts_up:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=250:repeats=6:tcp_ts=99999999:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=300:repeats=6:tcp_ts=-5000000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=350:repeats=8:tcp_seq=1000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:blob=TLS_VK:repeats=6:tcp_ts=-600000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=-600000:tcp_ts_up:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=0:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=99999999:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=8:tcp_seq=1000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:blob=TLS_VK:repeats=6:tcp_ts=-600000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=-600000:tcp_ts_up:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=0:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=6:tcp_ts=99999999:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fake:ip_id=zero:blob=TLS_VK:repeats=8:tcp_seq=1000:tcp_md5:badsum:padencap:ip_autottl=2,3-20:ip6_autottl=2,3-20
--lua-desync=fakedsplit:seqovl_pattern=TLS_VK:seqovl=490:repeats=6:tcp_ts=-600000:tcp_md5:badsum:nodrop

--new
--filter-udp=443
--filter-l7=quic
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=quic_initial
--import=START_QUIC

[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun,quic
--payload=quic_initial,discord_ip_discovery,stun
--import=START_QUIC

[END]
--new
--filter-tcp=80,443,%DiscordPort%
--filter-l7=http,tls
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello,http_req
--import=START_TLS

[amazon]
use_in>>game_mod

[cloudflare]
use_in>>game_mod

[roblox]
use_in>>game_mod

[game_mod]
--new
--filter-tcp=80,443,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=tls_client_hello
--import=START_TLS

--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--out-range=-n2
--payload=all
--import=START_QUIC