// Shared boilerplate for the strategy configs. A config writes %TEMPLATES_<NAME>%
// where a block belongs and the generator splices the lines of the matching
// [TEMPLATES:<NAME>] anchor in, before the section scan - so sections, %BLOCKLIST%
// and use_in>> inside a block work exactly as if they were written in the config.
// Blocks may reference other blocks. Add a block by adding an anchor and using
// its name as a token; keep whatever varies per strategy (payload, import, plans)
// in the config itself.

[TEMPLATES:WF]
--wf-tcp-in=80,443,%DiscordPort%
--wf-udp-in=443,%DiscordPortUPD%,%GamePort%
--wf-tcp-out=80,443,%DiscordPort%
--wf-udp-out=443,%DiscordPortUPD%,%GamePort%
%INIT_LUA%
%INIT_BLOB%

[TEMPLATES:DISCORD_UDP]
[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun,quic

[TEMPLATES:DISCORD_MEDIA]
--new
--filter-tcp=%DiscordPort%
--filter-l7=tls
--hostlist-domains=discord.media

[TEMPLATES:YOUTUBE_TCP]
[youtube]
--new
--filter-tcp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--filter-l7=http,tls

[TEMPLATES:END_TCP]
[END]
--new
--filter-tcp=80,443,%DiscordPort%
--filter-l7=http,tls
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:SERVICE_LISTS]
[amazon]
use_in>>game_mod
[cloudflare]
use_in>>game_mod

[TEMPLATES:GAME_TCP]
--new
--filter-tcp=80,443,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:GAME_UDP]
--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:HEAD]
[START]
--ctrack-disable=0
%TEMPLATES_WF%
--blob=fake_default_udp:0x00000000000000000000000000000000
--blob=JUNK_00:0x00
--blob=JUNK_01:0x01

[TEMPLATES:TAIL]
--new
--template=START_VOICE
--in-range=a
--lua-desync=auto_strategy:fails=6:start=1
--in-range=x
--lua-desync=fake:blob=VOICE_PRE:strategy=1
--lua-desync=fake:blob=JUNK_00:strategy=1
--lua-desync=fake:blob=JUNK_01:strategy=1
--lua-desync=send:delay=50:strategy=1
--lua-desync=drop:strategy=1
--lua-desync=fake:blob=VOICE_PRE:strategy=2
--lua-desync=send:delay=50:strategy=2
--lua-desync=drop:strategy=2

--new
--filter-udp=443
--filter-l7=quic
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=quic_initial
--import=START_QUIC

%TEMPLATES_DISCORD_UDP%
--payload=all
--import=START_VOICE

%TEMPLATES_END_TCP%
--payload=tls_client_hello,http_req
--import=START_TLS

%TEMPLATES_SERVICE_LISTS%

[game_mod]
%TEMPLATES_GAME_TCP%
--payload=tls_client_hello
--import=START_TLS

%TEMPLATES_GAME_UDP%
--out-range=-n8
--payload=all
--import=START_VOICE
