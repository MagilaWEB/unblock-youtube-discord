// Shared boilerplate for the strategy configs. A config writes %TEMPLATES_<NAME>%
// where a block belongs and the generator splices the lines of the matching
// [TEMPLATES:<NAME>] anchor in, before the section scan - so sections, %BLOCKLIST%
// and use_in>> inside a block work exactly as if they were written in the config.
// Blocks may reference other blocks. Add a block by adding an anchor and using
// its name as a token; keep whatever varies per strategy (payload, import, plans)
// in the config itself.

[TEMPLATES:WF]
--wf-tcp-in=80,443,%DiscordPort%
--wf-udp-in=443,%DiscordPortUPD%,%GamePort%
--wf-tcp-out=80,443,%DiscordPort%
--wf-udp-out=443,%DiscordPortUPD%,%GamePort%
%INIT_LUA%
--lua-init=unblock_host_policy[[stream=googlevideo.com,c.youtube.com,fbcdn.net;group=discord.media]]
%INIT_BLOB%

[TEMPLATES:DISCORD_UDP]
[discord]
--new
--filter-udp=%DiscordPortUPD%
--filter-l7=discord,stun,quic

[TEMPLATES:DISCORD_MEDIA]
--new
--filter-tcp=%DiscordPort%
--filter-l7=tls
--hostlist-domains=discord.media

[TEMPLATES:YOUTUBE]
[youtube]
// YouTube streaming video gets its own QUIC profile, spliced in ahead of the
// generic UDP/443 one (a connection is bound to the first matching profile, so
// this one takes googlevideo and nothing else). The difference from the generic
// plan is the payload scope: --payload=all lets the desync touch the start of
// the whole flow, not only the QUIC Initial, which is where the provider's
// shaper classifies the stream. --out-range=-n4 keeps it to the flow start:
// the ops are per-packet, and a fake/delay on every data packet would wreck the
// throughput it is meant to protect. auto_strategy keeps --out-range=a so it
// still counts every outgoing packet (udp_out would never trigger otherwise).
--new
--filter-udp=443
--filter-l7=quic
--hostlist-domains=googlevideo.com,c.youtube.com
--payload=all
--in-range=a
--out-range=a
--lua-desync=auto_strategy:start=1:fails=6:time=90:udp_out=8
--in-range=x
--out-range=-n4
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:strategy=1
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:badsum:strategy=2
--lua-desync=fake:blob=QUIC_VK:repeats=6:badsum:strategy=3
--lua-desync=fake:blob=QUIC_RUTRACKER:repeats=6:badsum:strategy=4
--lua-desync=fake:blob=fake_default_udp:repeats=6:badsum:strategy=5
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ip_ttl=5:strategy=6
--lua-desync=fake:blob=QUIC_GOOGLE:repeats=6:ipfrag:ipfrag_pos_udp=8:badsum:strategy=7
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:strategy=8
--lua-desync=drop:strategy=8
--lua-desync=send:ipfrag:ipfrag_pos_udp=8:ipfrag_disorder:strategy=9
--lua-desync=drop:strategy=9
--lua-desync=udplen:increment=2:strategy=10
--lua-desync=udplen:increment=64:strategy=11
--lua-desync=fake:blob=QUIC_4PDA:repeats=6:badsum:strategy=12

[TEMPLATES:YOUTUBE_TCP]
--new
--filter-tcp=443
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--filter-l7=http,tls

[TEMPLATES:END_TCP]
[END]
--new
--filter-tcp=80,443,%DiscordPort%
--filter-l7=http,tls
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:SERVICE_LISTS]
[amazon]
use_in>>game_mod
[cloudflare]
use_in>>game_mod

[TEMPLATES:GAME_TCP]
--new
--filter-tcp=80,443,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:GAME_UDP]
--new
--filter-udp=0,%GamePort%
%IP-SETLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%

[TEMPLATES:HEAD]
[START]
--ctrack-disable=0
%TEMPLATES_WF%
--blob=fake_default_udp:0x00000000000000000000000000000000
--blob=JUNK_00:0x00
--blob=JUNK_01:0x01

[TEMPLATES:TAIL]
--new
--template=START_VOICE
--in-range=a
--lua-desync=auto_strategy:fails=6:start=1
--in-range=x
--lua-desync=fake:blob=VOICE_PRE:strategy=1
--lua-desync=fake:blob=JUNK_00:strategy=1
--lua-desync=fake:blob=JUNK_01:strategy=1
--lua-desync=send:delay=50:strategy=1
--lua-desync=drop:strategy=1
--lua-desync=fake:blob=VOICE_PRE:strategy=2
--lua-desync=send:delay=50:strategy=2
--lua-desync=drop:strategy=2

%TEMPLATES_YOUTUBE%

%TEMPLATES_DISCORD_UDP%
--payload=all
--import=START_VOICE

%TEMPLATES_END_TCP%
--payload=tls_client_hello,http_req
--import=START_TLS

--new
--filter-udp=443
--filter-l7=quic
%BLOCKLIST%
%DOMAINS-EXCLUDE%
%IP-EXCLUDE%
--payload=quic_initial
--import=START_QUIC

%TEMPLATES_SERVICE_LISTS%

[game_mod]
%TEMPLATES_GAME_TCP%
--payload=tls_client_hello
--import=START_TLS

%TEMPLATES_GAME_UDP%
--out-range=-n8
--payload=all
--import=START_VOICE
